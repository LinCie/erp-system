{
  "imports": {
    "@/": "./src/",
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@3.954.0",
    "@aws-sdk/s3-request-presigner": "npm:@aws-sdk/s3-request-presigner@3.954.0",
    "@google/genai": "npm:@google/genai@^1.31.0",
    "@hono/swagger-ui": "npm:@hono/swagger-ui@^0.5.1",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.1.5",
    "@sentry/node": "npm:@sentry/node@^10.32.1",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/crypto": "jsr:@std/crypto@^1.0.5",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/path": "jsr:@std/path@^1.1.3",
    "@std/text": "jsr:@std/text@^1.0.16",
    "bcryptjs": "npm:bcryptjs@^3.0.2",
    "fast-check": "npm:fast-check@^3.0.0",
    "hono": "npm:hono@^4.10.7",
    "kysely": "npm:kysely@^0.28.8",
    "mysql2": "npm:mysql2",
    "redis": "npm:redis@^5.10.0",
    "zod": "npm:zod@^4.1.13"
  },
  "tasks": {
    "start": "deno run --allow-all --env-file src/main.ts",
    "dev": "deno run --watch --allow-all --env-file ./src/main.ts",
    "db:generate": "deno run --allow-all npm:kysely-codegen --out-file ./src/shared/infrastructure/persistence/database.d.ts",
    "db:migrate": "deno run --allow-all --env-file scripts/migrate.ts",
    "db:rollback": "deno run --allow-all --env-file scripts/rollback.ts",
    "create:module": "deno run --allow-write --allow-read scripts/create-module.ts",
    "create:migration": "deno run --allow-write --allow-read scripts/create-migration.ts",
    "test": "deno test --allow-env --allow-read --allow-net",
    "test:coverage": "deno test --allow-env --allow-read --allow-net --coverage=cov_profile",
    "test:item": "deno test --allow-env --allow-read --allow-net src/modules/item/"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx",
    "strict": true
  },
  "nodeModulesDir": "auto"
}
